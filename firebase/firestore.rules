rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /Users/{document} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow write: if false;
      // A user may delete their own profile, which is what the in-app
      // "Delete Account" flow requires. Nobody may delete anyone else's.
      allow delete: if request.auth != null && request.auth.uid == document;
    }

    match /Cards/{document} {
      allow create: if false;
      allow read: if request.auth != null;
      allow write: if false;
      allow delete: if false;
    }

    match /PlayerStats/{document} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow write: if request.auth != null;
      allow delete: if request.auth != null;
    }

    match /Que/{document} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow write: if request.auth != null;
      // A user may remove a queue entry they are a participant in, so that
      // account deletion does not leave them sitting in matchmaking.
      allow delete: if request.auth != null &&
                    (resource.data.PlayerA == request.auth.uid ||
                     resource.data.PlayerB == request.auth.uid);
    }

    match /Games/{document} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow write: if request.auth != null;
      allow delete: if false;
    }
  }
}
