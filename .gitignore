# The .vscode folder contains launch configuration and tasks you actually want to
# commit. In that case, you should gitadd the .vscode folder, then check in
# the below rule to ignore only settings, such as which configuration to use
# .vscode/*
# !.vscode/launch.json
# !.vscode/tasks.json
# !.vscode/settings.json
# .vscode/extensions.json
.vscode/

